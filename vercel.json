{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf dist && mkdir -p dist && cp site/linen-legends-framer.html dist/index.html && cp -R site/linen-legends-framer-assets dist/ && printf 'User-agent: *\\nAllow: /\\n' > dist/robots.txt",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/linen-legends-framer-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
